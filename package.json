{
  "name": "postjson-watch",
  "version": "1.0.1",
  "description": "Watch a directory tree and POST .json files as their raw contents whenever they are saved, from any editor, on any OS.",
  "type": "module",
  "bin": {
    "postjson-watch": "bin/cli.js"
  },
  "exports": {
    "./http": "./src/http.js",
    "./config": "./src/config.js"
  },
  "files": [
    "bin/",
    "src/",
    "postjson.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "watch",
    "file-watcher",
    "json",
    "post",
    "http",
    "on-save",
    "webhook",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiecrisp/postjson-watch.git"
  },
  "homepage": "https://github.com/jamiecrisp/postjson-watch#readme",
  "bugs": {
    "url": "https://github.com/jamiecrisp/postjson-watch/issues"
  },
  "author": "jamiecrisp",
  "dependencies": {
    "chokidar": "^4.0.0"
  },
  "license": "MIT"
}
